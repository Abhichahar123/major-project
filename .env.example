# Copy to .env and fill in the values marked REQUIRED.
#   cp .env.example .env
# Never commit .env. It is listed in .gitignore.

# --- Application -------------------------------------------------------------
APP_NAME=Cyber Threat Intelligence API
# development | test | production (production applies stricter validation)
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
API_V1_PREFIX=/api/v1
# Comma-separated allowlist of browser origins, e.g. the Flutter web dev server.
# Leave empty to disable cross-origin access. "*" is rejected in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Admin key (used by ingestion endpoints in a later phase) ----------------
# Required in production: a random value of at least 32 characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Admin operations stay disabled while this is empty.
ADMIN_API_KEY=

# --- PostgreSQL (Docker Compose) ---------------------------------------------
POSTGRES_DB=cti
POSTGRES_USER=cti
# REQUIRED. Use letters, digits, "-" and "_" only, so it is safe inside a URL.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
API_PORT=8000

# --- Database URL for running the API on the host ---------------------------
# REQUIRED when running uvicorn directly. Use the same password as POSTGRES_PASSWORD.
# (Docker Compose builds its own URL with host "db" and ignores this line.)
DATABASE_URL=postgresql+psycopg://cti:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/cti
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000
