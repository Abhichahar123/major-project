# Copy to .env and fill in the values marked REQUIRED:   cp .env.example .env
# Never commit .env (it is in .gitignore). Real environment variables override .env.

# --- Application -----------------------------------------------------------------
APP_NAME=Cyber Threat Intelligence API
# development | test | production (production enforces stricter validation)
ENVIRONMENT=development
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
API_V1_PREFIX=/api/v1
# Comma-separated browser origins allowed to call the API (the Flutter web app).
# "*" and http:// origins are rejected in production.
CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090
# Largest accepted request body in bytes (uploads are additionally limited to 512 KB).
MAX_REQUEST_BODY_BYTES=1048576

# --- Admin key (protects POST /api/v1/admin/ingestion/jobs) ------------------------
# REQUIRED in production: a random value of at least 32 characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Admin endpoints return 503 while this is empty or too short.
ADMIN_API_KEY=

# --- PostgreSQL (Docker Compose) -----------------------------------------------------
POSTGRES_DB=cti
POSTGRES_USER=cti
# REQUIRED. Letters, digits, "-" and "_" only, so it is safe inside a URL.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=8090

# --- Database URL for running the API or CLI on the host ----------------------------
# REQUIRED outside Docker. Use the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://cti:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/cti
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000

# --- Embeddings ----------------------------------------------------------------------
# hashing: built-in, no download, lexical (not semantic).
# ollama:  semantic embeddings from Ollama, e.g. EMBEDDING_MODEL=nomic-embed-text (768-d).
# none:    keyword search only.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60

# --- LLM -----------------------------------------------------------------------------
# ollama (default) | openai_compatible | mock (tests only) | none (evidence-only answers)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
# On the host: http://localhost:11434. Compose sets http://ollama:11434 itself.
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.1
# Only for LLM_PROVIDER=openai_compatible. Questions and evidence are sent to that provider.
LLM_BASE_URL=
LLM_API_KEY=
RAG_TOP_K=8
RAG_MAX_CONTEXT_CHARS=12000

# --- Data sources ----------------------------------------------------------------------
# Optional: raises NVD rate limits (https://nvd.nist.gov/developers/request-an-api-key).
NVD_API_KEY=
# Dependency analysis: also query api.osv.dev (sends package names to OSV). Off by default.
OSV_ONLINE_LOOKUP=false
INGESTION_CONCURRENCY=8

# --- Rate limits (requests per minute per client; 0 disables) -------------------------
RATE_LIMIT_SEARCH_PER_MINUTE=120
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_DEPENDENCIES_PER_MINUTE=20
RATE_LIMIT_ADMIN_PER_MINUTE=10
